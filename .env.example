# Mastery Key Coach — Production Environment Template (.env.example)

# Application & Environment Settings
ENVIRONMENT=production
DEBUG=false
APP_NAME=AI Goal Coach API
SECRET_KEY=change_this_to_a_secure_random_64_char_secret_key

# Service URLs & CORS
FRONTEND_URL=https://app.masterykeycoach.com
BACKEND_URL=https://api.masterykeycoach.com
CORS_ORIGINS=https://app.masterykeycoach.com

# Database Connection (PostgreSQL for Production, SQLite for Local Dev)
DATABASE_URL=postgresql://mkc_user:mkc_secure_password@postgres:5432/mkc_db

# Redis Connection (Pub/Sub & WebSocket Event Broker)
REDIS_URL=redis://redis:6379/0

# Gemini AI API Configuration
GEMINI_API_KEY=your_production_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Session & Security Settings
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

# SMTP Email Notification Service
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_api_key
SMTP_FROM_EMAIL=noreply@masterykeycoach.com
SMTP_FROM_NAME=Mastery Key Coach
SMTP_USE_TLS=true
