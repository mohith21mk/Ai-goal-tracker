# Frontend Environment Configuration Template (.env.example)

# Production Backend API URL (leave empty if frontend and backend share the same domain/reverse proxy)
VITE_API_URL=https://mkc-backend-iguj.onrender.com/

# Production WebSocket Base URL (leave empty for automatic resolution via location.host / VITE_API_URL)
VITE_WS_URL=ws://localhost:8000/api/chat/ws
